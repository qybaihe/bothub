{
  "name": "bothub",
  "version": "0.4.0",
  "private": false,
  "description": "BotHub — a desktop hub for multi-account bots",
  "main": "./out/main/index.js",
  "author": "qybaihe",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.mts",
    "build": "npm run typecheck && electron-vite build",
    "build:web": "vite build --config vite.web.config.mts",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "postinstall": "install-electron",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs",
    "dist:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win",
    "dist:dir": "npm run build && electron-builder --config electron-builder.config.cjs --mac --arm64 --dir",
    "release": "npm run build && electron-builder --config electron-builder.config.cjs --publish always"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "clsx": "^2.1.1",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "zustand": "^5.0.16"
  },
  "dependencies": {
    "@types/ws": "^8.18.2",
    "electron-updater": "^6.8.11",
    "https-proxy-agent": "^7.0.6",
    "socks-proxy-agent": "^8.0.5",
    "undici": "^8.12.4",
    "ws": "^8.22.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qybaihe/bothub.git"
  },
  "homepage": "https://github.com/qybaihe/bothub",
  "bugs": {
    "url": "https://github.com/qybaihe/bothub/issues"
  }
}
